# UAT Environment Configuration
# Used for User Acceptance Testing
# Service: https://fincore-webui-uat-*.europe-west2.run.app

# API Configuration (will be updated after backend deployment)
REACT_APP_API_BASE_URL=https://fincore-uat-api-994490239798.europe-west2.run.app/api
REACT_APP_MOCK_AUTH=false

# Application Configuration
REACT_APP_NAME=FinCore UAT
REACT_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=uat

# Feature Flags for UAT
REACT_APP_ENABLE_DEBUG=true
REACT_APP_ENABLE_MOCK_API=false

# Build Configuration
GENERATE_SOURCEMAP=true
